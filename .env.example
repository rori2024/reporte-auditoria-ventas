# ===========================================================================
#  Plantilla de configuración
# ---------------------------------------------------------------------------
#  Cópiese como `.env` y rellénese con los valores de verdad, que se piden al
#  departamento de sistemas. El `.env` NO se versiona; este archivo sí, para
#  que quien clone el proyecto sepa qué hace falta.
#
#  Aquí no se escribe ninguna credencial real, ni siquiera "de pruebas": lo
#  que se pone en un archivo versionado acaba publicado.
# ===========================================================================

# --- AS400 ----------------------------------------------------------------
# Servidor, usuario y clave de la conexión ODBC.
AS400_HOST=
AS400_USER=
AS400_PASS=

# El nombre exacto del driver instalado en el equipo. Ojo: el de IBM se llama
# "(32-bit)" pero está registrado también en 64 bits, que es lo que usa PHP.
AS400_DRIVER=Client Access ODBC Driver (32-bit)

# Qué mapa de bibliotecas se usa:
#   desarrollo -> config/libreriasDevs.txt   (bibliotecas de pruebas)
#   produccion -> config/librerias.txt       (las de verdad)
AS400_LIBRERIAS=desarrollo

# --- Intranet: identidad del usuario y permisos ---------------------------
# Interruptor de TODAS las validaciones de acceso.
#   no -> desarrollo: no se comprueba el permiso y se trabaja como el usuario
#         de pruebas. La cabecera muestra un distintivo "PRUEBAS".
#   si -> produccion: se exige usuario, id de app y permiso concedido.
INTRANET_VALIDAR=no
INTRANET_USUARIO_PRUEBAS=

# Id de ESTA aplicación en la intranet. Lo asigna quien la administra.
# Vacío y con la validación encendida, la aplicación se cierra a propósito.
INTRANET_APP_ID=

# Base de datos de la intranet (tablas usuarios y app_externa_permisos*)
INTRANET_DB_HOST=
INTRANET_DB_PORT=3306
INTRANET_DB_NAME=intranet
INTRANET_DB_USER=
INTRANET_DB_PASS=

# De dónde cuelgan las fotos de perfil, visto desde esta aplicación
INTRANET_URL_PERFILES=
